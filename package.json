{
  "name": "FoxCub-frontend",
  "description": "Fox&Cub",
  "version": "1.2.12",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prod": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --host",
    "release": "standard-version",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "semantic-release": "semantic-release",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prepare": "husky && husky install",
    "format": "prettier '**/*.{json,yaml,js,jsx,ts,tsx,css,md}' --write --ignore-path .gitignore",
    "format:check": "prettier '**/*.{json,yaml,js,jsx,ts,tsx,css,md}' --check --ignore-path .gitignore",
    "lint-staged": "lint-staged --concurrent false"
  },
  "keywords": [
    "react",
    "boilerplate",
    "typescript",
    "starter"
  ],
  "author": "sohyun-choi <sohyun4283@naver.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/choisohyun/react-vite-ts-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/choisohyun/react-vite-ts-boilerplate/issues"
  },
  "homepage": "https://github.com/choisohyun/react-vite-ts-boilerplate#readme",
  "dependencies": {
    "@hookform/resolvers": "^4.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.80.3",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.541.0",
    "react": "18.3.1",
    "react-day-picker": "^10.0.0",
    "react-dom": "18.3.1",
    "react-h5-audio-player": "^3.10.2",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-international-phone": "^4.8.0",
    "react-router-dom": "6.28.1",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1",
    "yup": "^1.6.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/dom": "8.20.1",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "14.5.2",
    "@types/country-list": "^2.1.4",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.70",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "0.34.7",
    "autoprefixer": "^10.4.21",
    "eslint": "8.23.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "8.0.3",
    "jsdom": "20.0.3",
    "lint-staged": "13.3.0",
    "postcss": "^8.5.3",
    "prettier": "2.7.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vite-plugin-checker": "0.8.0",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "0.34.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "yarn@1.22.22"
}